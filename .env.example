# Hermes Web UI - Environment Configuration
# Copy to .env and fill in values before running

# Port (Railway sets this automatically)
PORT=3000

# REQUIRED: Cryptographically strong password/token for WebSocket auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_UI_PASSWORD=change_this_immediately

# REQUIRED: Your Railway app domain for CORS enforcement
# e.g. https://your-app.up.railway.app
ALLOWED_ORIGIN=http://localhost:3000

# REQUIRED: OpenRouter API key for the agent brain
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Override the default model (default: openai/gpt-4o)
# Examples: anthropic/claude-3.5-sonnet, google/gemini-pro-1.5, meta-llama/llama-3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o

# Optional: Working directory for the agent (default: ./data/workspace)
# On Railway, mount a volume at /app/data for persistence
WORKDIR=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WebSocket settings
WS_MAX_PAYLOAD=1048576

# Railway API (for agent infrastructure management)
# Create at: https://railway.com/account/tokens
# Use "No workspace" for account-level access, or select your workspace
RAILWAY_API_TOKEN=

# Optional: Override project ID if token can't auto-discover projects
# Find your project ID in the Railway dashboard URL: railway.com/project/<ID>
RAILWAY_PROJECT_ID=
